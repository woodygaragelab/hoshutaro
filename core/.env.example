# HOSHUTARO core エンジン — 環境変数サンプル（プラン WS3-3）
#
# `core/.env` が存在しない初回起動時、本ファイルから自動コピーされます
# （core/app/config.py 参照）。
#
# 既定はローカル LLM（Gemma 4 E2B-it + OpenVINO + MTP）一本化。クラウド経路は
# APP_MODE=cloud + cloud_proxy 関連の env を設定したときのみ有効。

# ── 動作モード ─────────────────────────────────────
# local: ローカル LLM（Gemma 4）。クラウド経路は無効。
# cloud: AWS Bedrock 経由 Claude（cloud_proxy Lambda）。
APP_MODE=local

# ── LLM アダプタ ───────────────────────────────────
# registry.LLM_MODELS のキーまたは MCP plugin id。
# 既定: ローカル Gemma 4 E2B-it。
LLM_ADAPTER=local_gemma_4_e2b_it
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ── モデル配置 ─────────────────────────────────────
# 初回セットアップ時に core/app/mu/setup/downloader.py が HF からダウンロードする先。
# 未設定なら ~/.hoshutaro/models/
HOSHUTARO_MODELS_DIR=
# target / drafter の HF リポジトリ（プラン WS1-3 で env 上書き可能化）。
# 未設定なら google/gemma-4-E2B-it / google/gemma-4-E2B-it-assistant が既定。
LOCAL_LLM_TARGET_HF_REPO=
LOCAL_LLM_DRAFTER_HF_REPO=
# OpenVINO IR の配置先。downloader 完了時に自動補完される。手動指定も可。
LOCAL_LLM_TARGET_MODEL_DIR=
LOCAL_LLM_DRAFTER_MODEL_DIR=
# HuggingFace Hub アクセストークン（Gemma 4 は gated モデル）。
HUGGINGFACE_HUB_TOKEN=

# ── OpenVINO デバイス ──────────────────────────────
# 未設定なら NPU > GPU > CPU の順に自動選択。明示指定例: NPU / GPU / CPU / HETERO:NPU,GPU
OPENVINO_DEVICE=

# ── クラウド LLM（cloud_proxy Lambda、APP_MODE=cloud 時のみ） ──
# Track D Sprint 3 で実装した Lambda Function URL。
LLM_PROXY_URL=
LLM_PROXY_JWT_TOKEN=

# ── GitHub PAT（プラグインダウンロード用） ──────────
GITHUB_PAT=

# ── 開発モード（ライセンスチェックをバイパス） ────
DEV_MODE=false

# ── Excel パイプライン スケール制御（プラン WS1-7） ──
# Phase 2 並列マッピングの最大同時数。LLM 過負荷時は 2 に下げる。
EXCEL_PIPELINE_MAX_CONCURRENCY=4
# Phase 3 チャンク変換のサイズ（行数）。
EXCEL_PIPELINE_CHUNK_SIZE=500
# Phase ごとの LLM 呼出タイムアウト（秒）。
EXCEL_PIPELINE_PHASE_TIMEOUT_SEC=180
# 機器マージ時のファジーマッチ閾値（0.0-1.0）。
EXCEL_PIPELINE_FUZZY_MATCH_THRESHOLD=0.8

# ── Maximo コネクタ（プラグイン経由、開発雛形） ────
# 別チームが実装するため、本リポジトリでは未使用。詳細は
# docs/13_MAXIMO_CONNECTOR_GUIDE.md を参照。
MAXIMO_BASE_URL=
MAXIMO_API_KEY=
MAXIMO_OBJECT_STRUCTURE=MXASSET
