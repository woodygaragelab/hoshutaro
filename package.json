    "axios": "^1.11.0",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.23.22",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.1",
    "react-virtuoso": "^4.18.4",
    "react-window": "^2.2.0",
